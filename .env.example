# Backend (FastAPI) configuration — consumed by docker-compose.
# Copy to `.env` and adjust. Every value has a sane default.

# Comma-separated browser origins allowed to call the API (CORS).
# Include your deployed UI origin in production.
NIDS_CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173

# Log verbosity: DEBUG | INFO | WARNING | ERROR
NIDS_LOG_LEVEL=INFO

# --- Optional tuning (defaults shown) ---
# Live demo stream rate in alerts/second.
# NIDS_STREAM_RATE_HZ=1.0
# Max rows accepted from an uploaded CSV.
# NIDS_MAX_UPLOAD_ROWS=5000
# Max flows that get SHAP attributions during /api/analyze.
# NIDS_ANALYZE_SHAP_CAP=50
# Path (inside the container) to a MaxMind GeoLite2-City.mmdb for real geo lookups.
# NIDS_GEOIP_DB_PATH=/geoip/GeoLite2-City.mmdb
