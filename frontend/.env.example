# Base URL of the NIDS backend API.
#
# Leave EMPTY for the production Docker image — nginx reverse-proxies the API on
# the same origin (see nginx.conf), so no absolute URL is needed.
#
# For local `npm run dev` against a backend on port 8000, use:
#   VITE_API_BASE=http://localhost:8000
#
# For a split deployment (frontend and API on different hosts), set the public
# API origin, e.g.:
#   VITE_API_BASE=https://api.nids.example.com
VITE_API_BASE=http://localhost:8000
